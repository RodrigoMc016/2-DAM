<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.shield.controller.UsuariosController" spacing="14">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Gestión de usuarios" styleClass="titulo-seccion"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo usuario" onAction="#onNuevo" styleClass="boton-principal"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" minWidth="50" maxWidth="70"/>
            <TableColumn fx:id="colUsername" text="Usuario"/>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colEmail" text="Correo"/>
            <TableColumn fx:id="colRol" text="Rol" minWidth="90" maxWidth="130"/>
            <TableColumn fx:id="colEstado" text="Estado" minWidth="90" maxWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnEditar" text="Editar" onAction="#onEditar" styleClass="boton-secundario"/>
        <Button fx:id="btnEstado" text="Desactivar" onAction="#onCambiarEstado" styleClass="boton-secundario"/>
        <Button fx:id="btnReset" text="Restablecer contraseña" onAction="#onRestablecer" styleClass="boton-secundario"/>
        <Label fx:id="lblMensaje" styleClass="subtitulo"/>
    </HBox>
</VBox>
